# Sahara build configuration for the pinned Firefox for Android tree.
# scripts/build.sh copies this to build/upstream/mozconfig.
#
# Artifact mode: Gecko is not compiled. GeckoView comes from Mozilla's published release build
# (see docs/BUILD.md), and only the Java/Kotlin app is built.
ac_add_options --enable-project=mobile/android
ac_add_options --enable-artifact-builds

# Fenix only (skips Focus and the sample apps).
ac_add_options --enable-android-subproject=fenix

# One ABI per build. scripts/build.sh fills in the target: aarch64-linux-android for the phone (arm64-v8a),
# x86_64-linux-android for the CI emulator test.
ac_add_options --target=@TARGET@

# Resolve Mozilla's published release GeckoView (org.mozilla.geckoview:geckoview-omni-<abi>:<version>)
# instead of expecting a locally built one. The release channel drops the channel suffix from the
# artifact name; MOZILLA_OFFICIAL drops "-SNAPSHOT" and adds the ABI suffix.
ac_add_options --enable-update-channel=release
export MOZILLA_OFFICIAL=1

# Installed by scripts/bootstrap-android.sh (no emulator, no system images).
ac_add_options --with-android-sdk=$HOME/.mozbuild/android-sdk-linux

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/objdir-sahara
