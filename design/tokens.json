{
  "$comment": "Values read from the Sahara design canvas (https://claude.ai/artifact/3o53n4Rr9KXD6zxo77jJNg). Core palette is the brief; 'support' colors are tints the design uses on top of it.",
  "name": "Sahara",
  "mascot": "Rimal the camel",
  "color": {
    "core": {
      "duneGold": { "hex": "#D97706", "use": "Primary: actions, active tab, focus" },
      "oasisTeal": { "hex": "#0D9488", "use": "Accent: protection, success, links" },
      "sahara": { "hex": "#1C1917", "use": "Background, dark mode" },
      "sandstone": { "hex": "#292524", "use": "Surfaces and cards" },
      "sunbleached": { "hex": "#FAFAF9", "use": "Text and highlights" }
    },
    "support": {
      "goldLight": "#fbbf24",
      "tealLight": "#2dd4bf",
      "creamSun": "#fde68a",
      "textSecondary": "#D6D3D1",
      "textMuted": "#A8A29E",
      "controlOff": "#57534e",
      "iconMuted": "#78716c",
      "surfaceRaised": "#38322f",
      "divider": "#353130",
      "ember": "#9a3412",
      "emberDeep": "#7c2d12"
    }
  },
  "font": {
    "display": { "family": "Sora", "weights": [500, 600, 700], "use": "Titles, wordmark" },
    "text": { "family": "Figtree", "weights": [400, 500, 600], "use": "Interface text" }
  },
  "shape": {
    "iconCornerFraction": 0.225,
    "cardRadiusDp": [20, 24],
    "pillRadiusDp": [28, 36],
    "minTouchTargetDp": 44
