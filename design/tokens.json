  "motion": {
    "durationMs": { "quick": 150, "standard": 280, "calm": 900, "ambient": "5000-70000" },
    "easing": { "standard": "cubic-bezier(0.4, 0, 0.2, 1)", "overshoot": "cubic-bezier(0.2, 0.9, 0.3, 1.25)" },
    "rules": ["Reduced motion shows a still frame", "Rimal loader replaces the page-load spinner"]
  },
  "appIcon": {
    "chosen": "5 · Cream sun",
    "background": "#1C1917",
    "sun": "#fde68a",
    "ground": "#D97706",
    "camel": "#1C1917",
    "note": "Softer, less orange. The other four colourways in the design are not used."
  }
